# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Local network example:  http://192.168.1.100:5173
# Cloudflare Tunnel example: https://your-tunnel.trycloudflare.com
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# ── Frontend (Vite build-time — must set BEFORE running npm run build) ─────────
# Local network: use the server's LAN IP so office browsers can reach the API.
# Remote (Cloudflare Tunnel): use the tunnel URL for the backend (if two tunnels).
# Default (same machine only):
VITE_API_BASE_URL=http://localhost:3001/api

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite DB is auto-created at backend/data/anjani.db — no setup needed.
# Override only if you move the db file elsewhere.
# DATABASE_PATH=./backend/data/anjani.db

# ── Backup ────────────────────────────────────────────────────────────────────
# Folder where JSON backups are stored (used by the Backup & Data tab).
# BACKUP_DIR=./backups
